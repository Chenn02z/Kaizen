TELEGRAM_TOKEN=
ALLOWED_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
# Local: docker compose Postgres. Production: Supabase session pooler URL, e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://kaizen:kaizen@localhost:5432/kaizen
LLM_API_KEY=
LLM_MODEL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# HTTPS origin of this deployment; the Telegram webhook is registered on startup when set.
PUBLIC_URL=
SCHEDULER_SECRET=
# Leave empty to self-host Mem0 on DATABASE_URL (pgvector).
MEM0_API_KEY=
APP_TIMEZONE=Asia/Singapore
